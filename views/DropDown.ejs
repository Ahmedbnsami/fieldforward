

<!DOCTYPE html>    <html lang="en">    <head>    
    <meta charset="UTF-8">    
    <meta http-equiv="X-UA-Compatible" content="IE=edge">    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">    
    <title>Dashboard | Smart Terra</title>    
    <link rel="stylesheet" href="DropDown.css">    </head>    <body>    
    <main>    
        <div class="container">    
            <h1>Agriculture Advisory Dashboard</h1>    
            <!-- Advice Section -->    
            <div class="advice-section flashcard">    
                <h2>Your Advisory</h2>    
                <!-- start as skeleton -->    
                <p id="adviceAI" class="skeleton skeleton-block skeleton-mask"></p>    
            </div>    <!-- Flashcard 1: Crop Selection & Rotation -->    
        <div class="flashcard">    
            <h2>Crop Selection & Rotation</h2>    
            <p>Drought Forecast: <span id="cropRotation-drought" class="skeleton skeleton-text" style="width: 140px;"></span></p>    
            <p>Vegetation Growth: <span id="cropRotation-vegetation" class="skeleton skeleton-text" style="width: 120px;"></span></p>    
            <p class="tip" id="cropRotation-tip"><span class="skeleton skeleton-text" style="width: 70%;"></span></p>    
        </div>    

        <!-- Flashcard 2: Fertilization & Nutrient Management -->    
        <div class="flashcard">    
            <h2>Fertilization & Nutrient Management</h2>    
            <p>Soil Moisture: <span id="fertilization-soil" class="skeleton skeleton-text" style="width: 90px;"></span></p>    
            <p>Rainfall Forecast: <span id="fertilization-rain" class="skeleton skeleton-text" style="width: 100px;"></span></p>    
            <p class="tip" id="fertilization-tip"><span class="skeleton skeleton-text" style="width: 70%;"></span></p>    
        </div>    

        <!-- Flashcard 3: Harvest Timing -->    
        <div class="flashcard">    
            <h2>Harvest Timing</h2>    
            <p>Precipitation Risk: <span id="harvest-precip" class="skeleton skeleton-text" style="width: 110px;"></span></p>    
            <p>ET Level: <span id="harvest-et" class="skeleton skeleton-text" style="width: 80px;"></span></p>    
            <p class="tip" id="harvest-tip"><span class="skeleton skeleton-text" style="width: 65%;"></span></p>    
        </div>    

        <!-- Flashcard 4: Pest & Disease Management -->    
        <div class="flashcard">    
            <h2>Pest & Disease Management</h2>    
            <p>Pest Outbreak Risk: <span id="pests-risk" class="skeleton skeleton-text" style="width: 100px;"></span></p>    
            <p>Fungal Growth Risk: <span id="pests-fungal" class="skeleton skeleton-text" style="width: 100px;"></span></p>    
            <p class="tip" id="pests-tip"><span class="skeleton skeleton-text" style="width: 60%;"></span></p>    
        </div>    

        <!-- Flashcard 5: Soil Health & Erosion Control -->    
        <div class="flashcard">    
            <h2>Soil Health & Erosion Control</h2>    
            <p>Flood Risk: <span id="soilHealth-flood" class="skeleton skeleton-text" style="width: 90px;"></span></p>    
            <p>Erosion Control Needed: <span id="soilHealth-erosion" class="skeleton skeleton-text" style="width: 70px;"></span></p>    
            <p class="tip" id="soilHealth-tip"><span class="skeleton skeleton-text" style="width: 60%;"></span></p>    
        </div>    

        <!-- Flashcard 6: Water Storage & Conservation -->    
        <div class="flashcard">    
            <h2>Water Storage & Conservation</h2>    
            <p>Drought Risk: <span id="water-drought" class="skeleton skeleton-text" style="width: 90px;"></span></p>    
            <p>Water Storage Suggested: <span id="water-storage" class="skeleton skeleton-text" style="width: 80px;"></span></p>    
            <p class="tip" id="water-tip"><span class="skeleton skeleton-text" style="width: 70%;"></span></p>    
        </div>    

        <!-- Flashcard 7: Livestock Management -->    
        <div class="flashcard">    
            <h2>Livestock Management</h2>    
            <p>Heat Stress Risk: <span id="livestock-heat" class="skeleton skeleton-text" style="width: 90px;"></span></p>    
            <p>Air Quality: <span id="livestock-air" class="skeleton skeleton-text" style="width: 80px;"></span></p>    
            <p class="tip" id="livestock-tip"><span class="skeleton skeleton-text" style="width: 65%;"></span></p>    
        </div>    

        <!-- Flashcard 8: Post-Harvest Handling -->    
        <div class="flashcard">    
            <h2>Post-Harvest Handling</h2>    
            <p>Humidity Risk: <span id="postHarvest-humidity" class="skeleton skeleton-text" style="width: 100px;"></span></p>    
            <p>Mold Risk: <span id="postHarvest-mold" class="skeleton skeleton-text" style="width: 100px;"></span></p>    
            <p class="tip" id="postHarvest-tip"><span class="skeleton skeleton-text" style="width: 60%;"></span></p>    
        </div>    

        <!-- Flashcard 9: Water-Flow Handling -->    
        <div class="flashcard">    
            <h2>Water-Flow Handling</h2>    
            <p>Pump State: <span id="pump-state" class="skeleton skeleton-text" style="width: 70px;"></span></p>    
            <p class="tip" id="pump-tip"><span class="skeleton skeleton-text" style="width: 50%;"></span></p>    
        </div>    
    </div>    
</main>    
<nav>
    <div id="nav-links">
        <a class="nav-link" href="/">
            <h2 class="nav-link-label rubik-font">Home</h2>
            <image class="nav-link-image skeleton" src="Main.PNG"/>  
        </a>
        <a class="nav-link" href="/Dashboard">
            <h2 class="nav-link-label rubik-font">Dashboard</h2>
            <image class="nav-link-image skeleton" src="DropDown.PNG"/>
        </a>
        <a class="nav-link" href="/recommend-crop">
            <h2 class="nav-link-label rubik-font">Recommend Crop</h2>
            <image class="nav-link-image skeleton" src="RecommendCrop.PNG"/>
        </a>
    </div>
</nav>

<button id="nav-toggle" type="button">
    <i class="open fa-light fa-bars-staggered"></i>
    <i class="close fa-light fa-xmark-large"></i>
</button>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('nav-links');

  navToggle.addEventListener('click', () => {
    navLinks.classList.toggle('active');
    navToggle.classList.toggle('active');
  });

    // --- helpers to toggle skeletons + animate cards ---    
    const FIELD_IDS = [    
        "cropRotation-drought","cropRotation-vegetation","cropRotation-tip",    
        "fertilization-soil","fertilization-rain","fertilization-tip",    
        "harvest-precip","harvest-et","harvest-tip",    
        "pests-risk","pests-fungal","pests-tip",    
        "soilHealth-flood","soilHealth-erosion","soilHealth-tip",    
        "water-drought","water-storage","water-tip",    
        "livestock-heat","livestock-air","livestock-tip",    
        "postHarvest-humidity","postHarvest-mold","postHarvest-tip",    
        "pump-state","pump-tip"    
    ];    

    function removeSkeletonById(id) {    
        const el = document.getElementById(id);    
        if (!el) return;    
        el.classList.remove('skeleton','skeleton-text','skeleton-block','skeleton-mask');    
        const card = el.closest('.flashcard');    
        if (card) card.classList.add('appear'); // fade-up once filled    
    }    

    function fillText(id, value) {    
        const el = document.getElementById(id);    
        if (!el) return;    
        el.innerText = value || "";    
        removeSkeletonById(id);    
    }    

    window.onload = function () {    
        if (navigator.geolocation) {    
            navigator.geolocation.getCurrentPosition(sendPositionToServer, showError);    
        } else {    
            showError({ code: -1, message: "Geolocation is not supported by this browser." });    
        }    
    };    

    function sendPositionToServer(position) {    
        let irrigation = prompt("Enter irrigation value in mm (leave blank if none):");    
        const latitude = position.coords.latitude;    
        const longitude = position.coords.longitude;    
        if (irrigation === null || irrigation.trim() === "") {    
            irrigation = null;    
        }    

        const adviceAI = document.getElementById('adviceAI');    
        adviceAI.innerText = "Loading advice... Please wait."; // keep your logic    
        // Also show skeleton mask while loading    
        adviceAI.classList.add('skeleton','skeleton-block','skeleton-mask');    

        fetch('/Dashboard', {    
            method: 'POST',    
            headers: { 'Content-Type': 'application/json' },    
            body: JSON.stringify({ lat: latitude, lon: longitude, irrigation: irrigation }),    
        })    
        .then(response => response.json())    
        .then(data => {    
            const advice = data.Advice;    
            if (!advice) {    
                adviceAI.classList.remove('skeleton','skeleton-block','skeleton-mask');    
                adviceAI.innerText = "No advice available.";    
                return;    
            }    

            // Summary    
            adviceAI.innerText = advice.summary || "No summary.";    
            adviceAI.classList.remove('skeleton','skeleton-block','skeleton-mask');    
            adviceAI.closest('.flashcard')?.classList.add('appear');    

            // Crop Rotation    
            fillText("cropRotation-drought", advice.cropRotation?.droughtForecast);    
            fillText("cropRotation-vegetation", advice.cropRotation?.vegetationGrowth);    
            fillText("cropRotation-tip", advice.cropRotation?.tip);    

            // Fertilization    
            fillText("fertilization-soil", advice.fertilization?.soilMoisture);    
            fillText("fertilization-rain", advice.fertilization?.rainfallForecast);    
            fillText("fertilization-tip", advice.fertilization?.tip);    

            // Harvest    
            fillText("harvest-precip", advice.harvest?.precipitationRisk);    
            fillText("harvest-et", advice.harvest?.etLevel);    
            fillText("harvest-tip", advice.harvest?.tip);    

            // Pests    
            fillText("pests-risk", advice.pests?.pestRisk);    
            fillText("pests-fungal", advice.pests?.fungalRisk);    
            fillText("pests-tip", advice.pests?.tip);    

            // Soil Health    
            fillText("soilHealth-flood", advice.soilHealth?.floodRisk);    
            fillText("soilHealth-erosion", advice.soilHealth?.erosionControl);    
            fillText("soilHealth-tip", advice.soilHealth?.tip);    

            // Water    
            fillText("water-drought", advice.water?.droughtRisk);    
            fillText("water-storage", advice.water?.waterStorage);    
            fillText("water-tip", advice.water?.tip);    

            // Livestock    
            fillText("livestock-heat", advice.livestock?.heatStress);    
            fillText("livestock-air", advice.livestock?.airQuality);    
            fillText("livestock-tip", advice.livestock?.tip);    

            // Post Harvest    
            fillText("postHarvest-humidity", advice.postHarvest?.humidityRisk);    
            fillText("postHarvest-mold", advice.postHarvest?.moldRisk);    
            fillText("postHarvest-tip", advice.postHarvest?.tip);    

            // Pump    
            fillText("pump-state", advice.pump?.state);    
            fillText("pump-tip", advice.pump?.tip);    
        })    
        .catch(error => {    
            // keep your original logic, just unmask the skeleton so user sees message    
            adviceAI.classList.remove('skeleton','skeleton-block','skeleton-mask');    
            adviceAI.innerText = "Failed to fetch advice.";    
            console.error(error);    
        });    
    }    

    function showError(error) {    
        switch (error.code) {    
            case error.PERMISSION_DENIED:    
                errorMessageElement.innerText = "You denied the request for Geolocation.";    
                break;    
            case error.POSITION_UNAVAILABLE:    
                errorMessageElement.innerText = "Location information is unavailable.";    
                break;    
            case error.TIMEOUT:    
                errorMessageElement.innerText = "The request to get user location timed out.";    
                break;    
            case -1:    
            case -2:    
                errorMessageElement.innerText = error.message;    
                break;    
            default:    
                errorMessageElement.innerText = "An unknown error occurred.";    
                break;    
        }    
    }    
</script>

</body>    </html>    
