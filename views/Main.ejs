<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | Farm Manager</title>
  <link rel="stylesheet" href="Main.css">
</head>

<body>
  <div class="all">
    <h1>Welcome to Farm Manager</h1>
    <div class="container">
      <section class="crop-selection">
        <h1>Select Your Crop</h1>
        <p>Select The Crop That You Will Get Data Based On.</p>
        <select id="crop-dropdown" class="dropdown">
          <% crops.forEach(crop => { %>
            <option value="<%= crop.name %>"><%= crop.name %></option>
          <% }) %>
        </select>
      </section>
  
      <button onclick="submitCrop()" id="submitBT" type="submit">Submit</button>
    </div>
  </div>

  <script>
    function submitCrop() {
      const crop = document.getElementById('crop-dropdown').value;
      window.location.href = `/Dashboard?crop=${crop}`;
    }
  </script>
</body>

</html>
